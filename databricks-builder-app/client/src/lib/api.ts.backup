// Warehouses API
export async function fetchWarehouses(): Promise<Warehouse[]> {
  return apiRequest<Warehouse[]>('/warehouses');
}

// Clusters API
export async function fetchClusters(): Promise<Cluster[]> {
  return apiRequest<Cluster[]>('/clusters');
}

// Skills API
export async function fetchSkillsTree(projectId: string): Promise<SkillTreeNode[]> {
  return apiRequest<SkillTreeNode[]>(`/projects/${projectId}/skills/tree`);
}

export async function fetchSkillFile(projectId: string, skillPath: string): Promise<string> {
  const response = await fetch(`${API_BASE}/projects/${projectId}/skills/file?path=${encodeURIComponent(skillPath)}`);
  if (!response.ok) {
    const error = await response.json().catch(() => ({ detail: response.statusText }));
    throw new Error(error.detail || 'Failed to fetch skill file');
  }
  return response.text();
}

export async function fetchSystemPrompt(params: FetchSystemPromptParams): Promise<string> {
  const response = await fetch(`${API_BASE}/projects/${params.project_id}/skills/system-prompt`);
  if (!response.ok) {
    const error = await response.json().catch(() => ({ detail: response.statusText }));
    throw new Error(error.detail || 'Failed to fetch system prompt');
  }
  return response.text();
}

export async function reloadProjectSkills(projectId: string): Promise<void> {
  await apiRequest(`/projects/${projectId}/skills/reload`, {
    method: 'POST',
  });
}

export async function deleteConversation(projectId: string, conversationId: string): Promise<void> {
  await apiRequest(`/projects/${projectId}/conversations/${conversationId}`, {
    method: 'DELETE',
  });
}

export async function fetchCatalogs(): Promise<Array<{name: string, comment: string | null}>> {
  return apiRequest<Array<{name: string, comment: string | null}>>('/catalogs');
}

export async function fetchSchemas(catalog: string): Promise<Array<{name: string, comment: string | null}>> {
  return apiRequest<Array<{name: string, comment: string | null}>>(`/schemas?catalog=${encodeURIComponent(catalog)}`);
}
