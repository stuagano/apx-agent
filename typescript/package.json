{
  "name": "appkit-agent",
  "version": "0.3.0",
  "description": "AppKit plugins for building AI agents on Databricks Apps — typed tools, A2A discovery, MCP server, dev UI",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "apx": "dist/cli/index.mjs"
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "databricks",
    "appkit",
    "agent",
    "mcp",
    "a2a"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@databricks/appkit": ">=0.20.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "zod": "^4.0.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@databricks/appkit": "^0.66.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.41",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.1",
    "express": "^5.2.1",
    "light-my-request": "^6.6.0",
    "tsdown": "^0.20.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
