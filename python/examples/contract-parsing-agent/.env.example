# Copy this file to .env and fill in your workspace values.
# .env is gitignored — never commit it.
#
# For Databricks Apps deployment, set these as app environment variables
# in databricks.yml (see resources.apps.<name>.config.env_variables) or
# via the Databricks Apps UI.

CATALOG=your_catalog_name
SCHEMA=your_schema_name
VOLUMES_RAW=/Volumes/your_catalog/your_schema/raw_contracts
VOLUMES_UPLOADS=/Volumes/your_catalog/your_schema/uploads

# Optional: URL of a companion data-inspector MCP app (comma-separated if multiple)
# SUB_AGENTS=https://your-data-inspector.aws.databricksapps.com
