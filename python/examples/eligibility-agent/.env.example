# Copy to .env and fill in values for your workspace.

# Databricks workspace
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-token

# Unity Catalog location for the demo tables and volumes
CATALOG=main
SCHEMA=eligibility_demo

# 2-letter state code used for residency verification (e.g. CA, TX, NY)
STATE_CODE=CA

# Display name for the program — appears in the reasoning trail
PROGRAM_NAME=Community Assistance Program

# Recency window for residency documents (days)
RESIDENCY_RECENCY_DAYS=60
