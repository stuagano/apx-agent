# Copy to .env and fill in your specialist URLs.
#
# For local dev, run each specialist on a different port:
#   billing:    uvicorn app:app --port 8001
#   technical:  uvicorn app:app --port 8002
#   account:    uvicorn app:app --port 8003
#   orchestrator: uvicorn app:app --port 8000

BILLING_SPECIALIST_URL=http://localhost:8001
TECHNICAL_SPECIALIST_URL=http://localhost:8002
ACCOUNT_SPECIALIST_URL=http://localhost:8003

MLFLOW_EXPERIMENT_ID=
MLFLOW_TRACKING_URI=databricks
APX_SMOKE_MODE=1
