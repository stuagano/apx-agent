# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# For Databricks Apps deployment, set these as app environment variables
# in databricks.yml (see resources.apps.<name>.config.env_variables) or
# via the Databricks Apps UI.

# Local Databricks profile (for uvicorn --reload local dev)
DATABRICKS_CONFIG_PROFILE=your-profile

# URL of the companion data-inspector MCP app
# Leave unset to run without sub-agent (agent falls back to direct SQL tools)
DATA_INSPECTOR_URL=https://your-data-inspector.aws.databricksapps.com

# Jira integration (for async webhook trigger)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_SERVICE_ACCOUNT_EMAIL=data-triage-bot@your-org.com
JIRA_API_TOKEN=your_api_token_here
JIRA_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
DATA_TRIAGE_JOB_ID=123
