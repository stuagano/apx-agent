# Copy to .env (scripts/quickstart.py writes this automatically) and fill in.

# MLflow tracing — Databricks-hosted by default.
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Users/your-email@company.com/memory-demo-dev
MLFLOW_EXPERIMENT_ID=

# LLM endpoint the agent calls. Override only if you've registered a
# different model and want to deploy against it without editing
# databricks.yml. Default: databricks-claude-sonnet-4-6.
# APX_MODEL=databricks-claude-sonnet-4-6
