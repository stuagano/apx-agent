# Configuration for local development. Copy to .env and fill in your values.

# Databricks CLI profile to use (default: DEFAULT).
DATABRICKS_PROFILE=DEFAULT

# UC catalog and schema (must match where you ran generate/*.py).
APX_CATALOG=main
APX_SCHEMA=precall

# Warehouse ID where the UC functions live.
APX_WAREHOUSE_ID=

# Optional: override the default LLM.
APX_MODEL=databricks-claude-sonnet-4-6
